{
  "name": "mc-lobby",
  "version": "1.0.0",
  "description": "MCLJ - Minecraft 联机工具",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "build": "npm run clean-dist && electron-builder --win portable",
    "build-exe": "npm run clean-dist && pkg . --target node24-win-x64 --output dist/服务器.exe && node -e \"require('fs').cpSync('lib/bin','dist/lib/bin',{recursive:true})\"",
    "clean-dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').mkdirSync('dist',{recursive:true})\""
  },
  "build": {
    "appId": "com.mc-lobby.app",
    "productName": "MCLJ",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "lib/bin",
        "to": "lib/bin"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.png"
    }
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "lib/**/*"
    ],
    "scripts": [
      "lib/**/*.js"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.20.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "socket.io-client": "^4.8.3"
  }
}
